[Unit]
Description=Roser — la voz de Barcelona Bitcoin Only
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roser
WorkingDirectory=/opt/roser
EnvironmentFile=/opt/roser/.env
ExecStart=/opt/roser/.venv/bin/python -m bbo_bot
Restart=always
RestartSec=10

# Solo necesita leer su checkout y hablar con la red.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/roser
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
