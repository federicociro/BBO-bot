# ─── Secrets ─────────────────────────────────────────────────────────────
# Viven en Vaultwarden, nunca en el repo:
#   rbw get "BBO bot telegram"    ·    rbw get "BBO bot anthropic"
ANTHROPIC_API_KEY=sk-ant-...
BBO_TELEGRAM_TOKEN=123456:ABC...

# ─── Chats ───────────────────────────────────────────────────────────────
# Formato Bot API: -100 delante para supergrupos y canales.
# La propia Roser te los dice con /chatid desde dentro del chat.
BBO_MAIN_CHAT_ID=-100...
BBO_ADMIN_CHAT_ID=-100...
BBO_CHANNEL_ID=-100...

# Tu user id, para avisos operativos por privado (distinto de los escalados).
BBO_OWNER_ID=

# Dónde queda registro de los escalados. Vacío = al privado del dueño.
# El aviso a los admins de verdad lo hace quien pregunta, con @admin.
BBO_ESCALATION_CHAT_ID=

# Quién puede hablarle por privado: user ids separados por coma.
# BBO_DM_OPEN=1 lo abre a cualquiera: solo para QA, nunca en producción.
BBO_DM_ALLOWLIST=
BBO_DM_OPEN=0

# ─── Modelo ──────────────────────────────────────────────────────────────
BBO_MODEL=claude-opus-5
BBO_EFFORT=medium

# ─── Datos externos ──────────────────────────────────────────────────────
BBO_MEMPOOL_URL=https://mempool.example.org/api
BBO_MEETUP_GROUP=bitcoin-barcelona
BBO_FIAT=EUR

# ─── Frenos de gasto ─────────────────────────────────────────────────────
# Sin esto, pegar un documento en varios mensajes cuesta euros. Ver el
# incidente en docs/NOTES.md.
BBO_COOLDOWN_S=15
BBO_MAX_CHARS_ENTRADA=1500
BBO_VENTANA_AGRUPADO_S=8
BBO_DAILY_TOKEN_BUDGET=500000

# ─── Canon al día ────────────────────────────────────────────────────────
# git pull cada N minutos y recarga si cambió. 0 = solo /recargar a mano.
BBO_GIT_PULL=1
BBO_AUTO_PULL_MIN=15
