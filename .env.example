# Secrets: en Vaultwarden (rbw), nunca en el repo.
#   rbw get "BBO bot telegram"
#   rbw get "BBO bot anthropic"
ANTHROPIC_API_KEY=sk-ant-...
BBO_TELEGRAM_TOKEN=123456:ABC...

# Chats (formato Bot API, con prefijo -100 para supergrupos y canales)
BBO_MAIN_CHAT_ID=-100...
BBO_ADMIN_CHAT_ID=-100...
BBO_CHANNEL_ID=-100...

# Quien puede hablarle por privado: user ids separados por coma.
# BBO_DM_OPEN=1 abre el privado a cualquiera: solo para QA, nunca en prod.
BBO_DM_ALLOWLIST=
BBO_DM_OPEN=0

# Tu user id: alertas operativas por privado (distinto de los escalados).
# Te lo dice la propia bot con /chatid.
BBO_OWNER_ID=

# Dónde caen los escalados urgentes. El log de admins se lee semanalmente y
# está silenciado, así que NO sirve como aviso: recibe copia sin notificación.
# Vacío = al privado del dueño.
BBO_ESCALATION_CHAT_ID=

BBO_MODEL=claude-opus-5
BBO_EFFORT=medium
BBO_MEMPOOL_URL=https://mempool.example.org/api
BBO_MEETUP_GROUP=bitcoin-barcelona
BBO_FIAT=EUR
BBO_COOLDOWN_S=15
BBO_DAILY_TOKEN_BUDGET=500000
